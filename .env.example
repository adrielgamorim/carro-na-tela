# Chave da FIPE (fipe.api.br). Fica só no servidor: usada pelo proxy do Vite
# (npm run dev / preview) e pelos scripts (npm run crawl:fipe). Nunca use o
# prefixo VITE_ numa chave: variáveis VITE_* vão para o bundle do navegador.
FIPE_TOKEN=
# Mais chaves para o crawler, usadas em sequência quando uma atinge o limite diário.
FIPE_TOKEN1=
FIPE_TOKEN2=

# Opcional: outra chave só para o proxy do site, para que as consultas dos
# visitantes não consumam a cota do crawler. Sem ela, o proxy usa FIPE_TOKEN.
FIPE_PROXY_TOKEN=

# Endereço do proxy visto pelo navegador. Padrão: /api/fipe (proxy do Vite).
# Em produção, aponte para o Worker (ex.: https://seu-dominio.com.br/api/fipe).
VITE_FIPE_API_URL=
