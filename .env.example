# Chave da FIPE (fipe.api.br). Fica só no servidor: usada pelo proxy do Vite
# (npm run dev / preview) e pelos scripts (npm run crawl:fipe). Nunca use o
# prefixo VITE_ numa chave: variáveis VITE_* vão para o bundle do navegador.
FIPE_TOKEN=
# Mais chaves para o crawler, usadas em sequência quando uma atinge o limite diário.
FIPE_TOKEN1=
FIPE_TOKEN2=

# Opcional: outra chave só para o proxy do site, para que as consultas dos
# visitantes não consumam a cota do crawler. Sem ela, o proxy usa FIPE_TOKEN.
FIPE_PROXY_TOKEN=

# Endereço do proxy visto pelo navegador. Padrão: /api/fipe, que serve tanto o
# proxy do Vite quanto o Worker de produção (site e proxy no mesmo domínio).
# Só preencha se o proxy ficar em outro domínio.
VITE_FIPE_API_URL=

# Opcional: bot password do Wikimedia (https://commons.wikimedia.org/wiki/Special:BotPasswords,
# só leitura basta) para npm run fetch:galeria. Sem conta, o Wikimedia limita a ~10
# pedidos por minuto (menos ainda em IP compartilhado); com ela, ~200.
# Usuário no formato "SuaConta@NomeDoBot".
WIKIMEDIA_BOT_USER=
WIKIMEDIA_BOT_PASSWORD=
