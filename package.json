{
  "name": "carro-na-tela",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "crawl:fipe": "node --env-file-if-exists=.env scripts/catalog/crawl-fipe.ts",
    "build:catalog": "node scripts/catalog/build-index.ts",
    "daily": "node scripts/catalog/daily.ts",
    "schedule:daily": "powershell -ExecutionPolicy Bypass -File scripts/schedule-daily.ps1",
    "unschedule:daily": "powershell -ExecutionPolicy Bypass -File scripts/schedule-daily.ps1 -Remove",
    "parse:pbev": "node scripts/inmetro/parse-pbev.ts",
    "fetch:wikidata": "node scripts/wikidata/fetch-wikidata.ts",
    "fetch:galeria": "node --env-file-if-exists=.env scripts/wikidata/fetch-gallery.ts",
    "fetch:anp": "node scripts/anp/fetch-anp.ts",
    "fetch:wmi": "node scripts/vin/fetch-wmi.ts",
    "fetch:frota": "node scripts/frota/fetch-frota.ts",
    "build:brand-icons": "node scripts/brands/build-brand-icons.ts",
    "fetch:brand-logos": "node scripts/brands/fetch-brand-logos.ts",
    "crawl:imprensa": "node scripts/imprensa/crawl-stellantis.ts",
    "extract:imprensa": "node scripts/imprensa/extract-stellantis.ts",
    "fichas:links": "node scripts/fichas/fetch-links.ts",
    "fichas:lista": "node scripts/fichas/build-list.ts",
    "fichas:ler": "node scripts/fichas/read-sheets.ts",
    "fichas:vw": "node scripts/fichas/fetch-vw.ts",
    "fichas:renault": "node scripts/fichas/fetch-renault.ts",
    "fichas:abertas": "node scripts/fichas/read-open-sheets.ts",
    "fichas:wayback": "node scripts/fichas/fetch-wayback.ts",
    "fetch:seguro": "node scripts/seguro/fetch-autoseg.ts",
    "fetch:latinncap": "node scripts/seguranca/fetch-latinncap.ts"
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^4.10.38",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "simple-icons": "^16.36.0"
  }
}
